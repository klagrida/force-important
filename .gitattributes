# cli.mjs ships as an executable with a `#!/usr/bin/env node` line. A CRLF
# shebang makes the published binary fail on Linux and macOS with
# `env: node\r: No such file or directory`, and a Windows checkout would
# introduce exactly that. Pin the published sources to LF on every platform.
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Golden-file fixtures are compared byte for byte; keep them LF on every
# platform so a Windows checkout can't change what the tests assert.
*.scss text eol=lf
