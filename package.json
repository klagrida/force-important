  "repository": {
    "type": "git",
    "url": "git+https://github.com/klagrida/force-important.git"
  },
  "license": "MIT",
  "author": "Khalil",
  "type": "module",
  "bin": {
    "force-important": "cli.mjs"
  },
  "files": [
